# ---------------------------------------------------------------------------
# cp runner/.env.example runner/.env  puis remplir ACCESS_TOKEN
# Le runner s'enregistre sur CE dépôt (même compte GitHub).
# ---------------------------------------------------------------------------

REPO_URL=https://github.com/moussIlyas/MlopsProject_Text_Classification_AGNews

# Fine-grained PAT avec "Administration: Read and write" sur ce repo.
# (PAT classic: scope "repo". Il faut être admin du dépôt.)
ACCESS_TOKEN=github_pat_REPLACE_ME

RUNNER_NAME=fedora-mlops-runner

# Label personnalisé: le workflow cible [self-hosted, linux, x64, python]
RUNNER_LABELS=python
